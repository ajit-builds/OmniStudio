# Studio Omni — Monorepo Environment Configuration Template
# Duplicate this file to .env and adjust variables as required.

# -----------------------------------------------------------------------------
# Frontend Application (apps/web) — Vercel Environment Variables
# -----------------------------------------------------------------------------
# Base URL for the Studio Omni Express API.
# In local development, defaults to '/api' (proxied by Vite to http://localhost:4000).
# In production on Vercel, configure this to your deployed API domain:
# Example: VITE_API_URL=https://api.studiomni.design/api
VITE_API_URL=/api

# -----------------------------------------------------------------------------
# Backend API (apps/api) — Node.js Server Environment Variables
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins.
# In production, include your custom domain and Vercel preview/production URLs:
# Example: CORS_ORIGIN=https://studiomni.design,https://studio-omni.vercel.app
CORS_ORIGIN=http://localhost:5173

# Email Delivery Provider: 'mock' (in-memory simulation) or 'resend' (live API transmission)
EMAIL_PROVIDER=mock
STUDIO_EMAIL_RECIPIENT=studio@studiomni.design
EMAIL_SENDER=inquiries@studiomni.design

# Resend API Key (required if EMAIL_PROVIDER=resend)
# Server-side only: never expose this key to client-side bundles
RESEND_API_KEY=re_placeholder_secret_key

# SMTP Credentials (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password_placeholder
