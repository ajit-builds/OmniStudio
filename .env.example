# Studio Omni Environment Configuration

# API Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:4000/api

# Email Delivery Configuration
# Supported providers: mock | resend | smtp
EMAIL_PROVIDER=mock
STUDIO_EMAIL_RECIPIENT=studio@studiomni.design
EMAIL_SENDER=inquiries@studiomni.design

# Resend Provider Credentials (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_placeholder_secret_key

# SMTP Provider Credentials (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password_placeholder
