# Studio Omni Backend API — Environment Configuration

# Server Network Configuration
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins.
# In production, include your custom domain and Vercel preview/production URLs:
# Example: CORS_ORIGIN=https://studiomni.design,https://studio-omni.vercel.app
CORS_ORIGIN=http://localhost:5173

# Email Delivery Provider: 'mock' (local/testing in-memory) or 'resend' (live API transmission)
EMAIL_PROVIDER=mock
STUDIO_EMAIL_RECIPIENT=studio@studiomni.design
EMAIL_SENDER=inquiries@studiomni.design

# Resend Provider Credentials (required if EMAIL_PROVIDER=resend)
# Server-side only: never expose this key to frontend or client environments
RESEND_API_KEY=re_placeholder_secret_key

# SMTP Provider Credentials (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password_placeholder
